# PostgreSQL database
DATABASE_URL="postgresql://user:password@host:5432/wavecraft"

# NextAuth
NEXTAUTH_SECRET="generate with: openssl rand -base64 32"
NEXTAUTH_URL="https://yourdomain.com"

# Self-hosted ACE-Step 1.5 API (GPU runtime; not a paid music API)
# Use the base origin only, e.g. https://your-gpu-host.example.com
ACESTEP_API_URL="http://127.0.0.1:8001"
ACESTEP_API_KEY="set-the-same-key-as-ACESTEP_API_KEY-on-the-engine"
ACESTEP_MODEL="acestep-v15-turbo"
