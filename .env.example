# Postgres connection string (e.g. from Supabase, Neon, RDS, Railway)
DATABASE_URL="postgresql://user:password@host:5432/wavecraft"

# NextAuth
NEXTAUTH_SECRET="generate with: openssl rand -base64 32"
NEXTAUTH_URL="https://yourdomain.com"

# Music generation provider — sign up with a real vendor and fill these in.
# Options: https://musicapi.ai · https://aimusicapi.org · https://www.mubert.com
MUSIC_API_BASE_URL="https://api.musicapi.ai/v1"
MUSIC_API_KEY="your-provider-api-key"
